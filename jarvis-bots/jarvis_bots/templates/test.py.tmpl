"""Tests for the generated @@BOT_NAME_TEXT@@ bot.

Generated by :mod:`jarvis_bots.scaffold` alongside ``@@BOT_MODULE@@.py``, and
written to pass against it unmodified.  Run it from the repository root so
that ``jarvis_bots`` is importable::

    python3 -m pytest @@BOT_MODULE@@ -q     # or just: python3 -m pytest

What is covered, and why these four
-----------------------------------
* a tick that sees nothing worth saying stays silent;
* the attention threshold raises once, with a stable key, and does not
  re-raise while it stands (``Event.attention_key``: the badge counts
  distinct open keys, so a nagging restock is one item, not ten);
* it clears on the way back down;
* the snapshot round trip keeps the counters *and* the raised/cleared state,
  so a restart does not re-alert on something already reported.

Nothing here touches a network, a wall clock or a real service: the probe and
the clock are injected, which is the point of taking them as arguments.
"""

from __future__ import annotations

import json
import pathlib
import sys

import pytest

# The bot module sits beside this test. pytest puts a test file's own
# directory on sys.path, but adding it explicitly means the file also works
# when it is run from somewhere else.
_HERE = pathlib.Path(__file__).resolve().parent
if str(_HERE) not in sys.path:
    sys.path.insert(0, str(_HERE))

from @@BOT_MODULE@@ import (  # noqa: E402  (path setup has to come first)
    ATTENTION_KEY,
    BOT_ID,
    INFO,
    @@BOT_CLASS@@,
    build,
    count_entries,
)
from jarvis_bots.contracts import BotState, Severity  # noqa: E402


class FakeClock:
    """An injected clock (contracts: "Time is injected everywhere")."""

    def __init__(self, t: float = 1_700_000_000.0) -> None:
        self.t = t

    def __call__(self) -> float:
        return self.t

    def advance(self, dt: float) -> None:
        self.t += dt


def make_bot(counts, *, threshold: int = 3, clock: FakeClock = None):
    """A bot whose probe reads from a script of counts instead of a disk."""
    clock = clock or FakeClock()
    remaining = list(counts)

    def probe(path: str) -> int:
        return remaining.pop(0) if remaining else 0

    bot = @@BOT_CLASS@@("(injected)", clock=clock, threshold=threshold, probe=probe)
    return bot, clock


def test_identity_matches_the_contract():
    assert INFO.id == BOT_ID == @@BOT_ID_LITERAL@@
    assert INFO.interval_s >= 5.0  # BotInfo's floor
    assert INFO.href


def test_quiet_tick_says_nothing():
    bot, clock = make_bot([1], threshold=3)

    events = bot.tick(clock())

    assert list(events) == []
    status = bot.status()
    assert status.state is BotState.RUNNING
    assert [s.label for s in status.stats] == ["Watching", "Peak"]
    assert status.stats[0].value == "1 item"


def test_status_is_idle_before_the_first_tick():
    bot, _clock = make_bot([1])

    assert bot.status().state is BotState.IDLE


def test_attention_is_raised_once_with_a_stable_key():
    bot, clock = make_bot([5, 6], threshold=3)

    first = list(bot.tick(clock()))
    clock.advance(300.0)
    second = list(bot.tick(clock()))

    assert len(first) == 1
    event = first[0]
    assert event.severity is Severity.ACTION
    assert event.attention_key == ATTENTION_KEY
    assert event.wants_attention
    assert event.href == INFO.href
    assert event.data["count"] == 5
    # Still over the threshold: one standing request, not a second one.
    assert second == []


def test_attention_clears_on_the_way_back_down():
    bot, clock = make_bot([5, 0], threshold=3)

    bot.tick(clock())
    clock.advance(300.0)
    cleared = list(bot.tick(clock()))

    assert len(cleared) == 1
    event = cleared[0]
    assert event.attention_key == ATTENTION_KEY
    assert event.severity < Severity.ACTION
    assert not event.wants_attention
    assert event.data["resolved"] is True


def test_snapshot_round_trip_keeps_counters_and_attention():
    bot, clock = make_bot([5, 9], threshold=3)
    bot.tick(clock())
    clock.advance(300.0)
    bot.tick(clock())
    saved = bot.snapshot()

    # Whatever the supervisor persists has to survive JSON, so check it does.
    assert json.loads(json.dumps(saved)) == saved

    restored, clock2 = make_bot([9], threshold=3)
    restored.restore(saved)

    assert restored.snapshot() == saved
    assert restored.status().stats[1].value == "9"  # peak came back
    # The item was already raised, so a restart must not alert again.
    assert list(restored.tick(clock2())) == []


def test_restore_survives_a_snapshot_it_does_not_understand():
    bot, _clock = make_bot([1])

    bot.restore({"version": 99, "peak": "not a number"})

    assert bot.snapshot()["peak"] == 0


def test_a_failing_probe_raises_for_the_supervisor_to_record():
    def angry(path: str) -> int:
        raise OSError("watched directory went away")

    bot = @@BOT_CLASS@@("(injected)", clock=FakeClock(), threshold=1, probe=angry)

    with pytest.raises(OSError):
        bot.tick(0.0)


def test_the_default_probe_reads_a_real_directory(tmp_path):
    for i in range(4):
        (tmp_path / f"item-{i}.txt").write_text("x", encoding="utf-8")

    assert count_entries(str(tmp_path)) == 4

    clock = FakeClock()
    bot = build(clock=clock, watch_dir=str(tmp_path), threshold=4)
    events = list(bot.tick(clock()))

    assert len(events) == 1
    assert events[0].wants_attention
    assert "read just now" in bot.status().detail
