"""@@BOT_NAME_TEXT@@ -- a Jarvis bot.

@@BOT_BLURB_TEXT@@

Generated by :mod:`jarvis_bots.scaffold`.  It runs as it stands: register it
and it ticks, keeps its counters across restarts, and raises exactly one item
of attention when its threshold is crossed.  Swap :func:`count_entries` and
the threshold and you have a different bot; the shape below is the whole
framework, and the comments are here so that reading one generated file
teaches it.

Wiring it up
------------
::

    from jarvis_bots.registry import BotRegistry
    from jarvis_bots.supervisor import Supervisor
    from @@BOT_MODULE@@ import build

    registry = BotRegistry([build(clock=clock, watch_dir="./inbox")])
    supervisor = Supervisor(registry, clock)
    supervisor.run_round()

The five things every bot owes the supervisor
---------------------------------------------
``INFO``
    Static identity, declared once (``contracts.BotInfo``), and set as the
    class attribute :attr:`@@BOT_CLASS@@.info`.  ``interval_s`` is the gap
    between ticks *when healthy*: the supervisor may widen it while the bot
    is failing and will never narrow it, so a bot that wants to be polled
    more often asks here, not by sleeping.

:meth:`~@@BOT_CLASS@@.tick`
    One unit of work, returning events.  It must return promptly and must
    not sleep -- the round is shared.  Raising is allowed and handled:
    contracts, "A bot never blocks another"; the supervisor records the
    failure against this bot's health, widens the interval, quarantines
    after ``QUARANTINE_AFTER_FAILURES`` in a row, and carries on with the
    others.  That is why :func:`count_entries` below simply raises when it
    cannot read the directory instead of swallowing it and reporting a zero.

Events
    The only output.  This bot never sends an alert itself; it says what it
    saw and the supervisor decides what earns a push (contracts, "Events are
    the only output").  Severity is the dial: ``INFO`` for a line nobody
    needs, ``NOTICE`` for the feed, ``ACTION`` for something the owner
    should decide, which is what drives the badge.

``ATTENTION_KEY``
    Stable across ticks.  One standing request counts once in the badge no
    matter how many ticks it survives (``Event.attention_key``).  This bot
    raises the key once on the way up and reports it resolved on the way
    back down; it does not re-raise every tick, which would be ten alerts
    for one fact.

:meth:`~@@BOT_CLASS@@.snapshot` / :meth:`~@@BOT_CLASS@@.restore`
    The whole of persistence from the bot's side: hand over JSON-able state,
    get it back on the next start (contracts, "State is the bot's,
    persistence is ours").

What this bot does not do, and no bot may
-----------------------------------------
Nothing here buys, pays, or commits to anything.  A bot that concludes the
owner should act raises an event with a link, and a person acts on it.

Offline and deterministic by construction
-----------------------------------------
The thing being watched is injected (``probe``) and so is the clock, which
``BaseBot`` requires and validates, exactly as ``jarvis_alerts`` injects its
sender.  This module opens no sockets and never calls ``time.time()``: the
composition root owns the clock, and a test hands in a fake one.
"""

from __future__ import annotations

import os
from typing import Any, Callable, Dict, List, Sequence

from jarvis_bots.base import BaseBot
from jarvis_bots.contracts import BotInfo, BotState, BotStatus, Event, Severity

#: The id the supervisor, the launcher and every event carry.  It is also the
#: key health, pausing and persisted state are filed under.
BOT_ID = @@BOT_ID_LITERAL@@

#: Static identity (contracts.BotInfo).  ``href`` is where the launcher's
#: Open button and every alert from this bot land.
INFO = BotInfo(
    id=BOT_ID,
    name=@@BOT_NAME_LITERAL@@,
    blurb=@@BOT_BLURB_LITERAL@@,
    kind=@@BOT_KIND_LITERAL@@,
    interval_s=300.0,
    href="/bots/@@BOT_ID@@",
    can_pause=True,
)

#: One standing request for a decision, keyed so repeats collapse into a
#: single badge item.  A module constant rather than a string built per
#: event, so it cannot drift between the tick that raises it and the tick
#: that resolves it.
ATTENTION_KEY = "@@BOT_ID@@:over-threshold"

#: How many watched entries it takes to be worth the owner's attention.
DEFAULT_THRESHOLD = 12

#: Snapshot format.  Bump it when the shape changes and teach :meth:`restore`
#: the old shape, because a snapshot on disk is always older than the code
#: reading it.
SNAPSHOT_VERSION = 1


def count_entries(path: str) -> int:
    """The default probe: how many entries the watched directory holds.

    Trivial, real, and offline -- one ``os.listdir``, no sockets.  It raises
    on an unreadable directory rather than reporting zero, because a zero the
    caller cannot tell apart from "I could not look" is how a watcher goes
    quiet without anyone noticing.  The supervisor is built for this: a raise
    is recorded against health and the round continues.
    """
    return len(os.listdir(path))


def _plural(n: int, word: str) -> str:
    return f"{n} {word}" if n == 1 else f"{n} {word}s"


class @@BOT_CLASS@@(BaseBot):
    """Watches one directory and speaks up when it fills past a threshold.

    Implements ``contracts.Bot``: ``info``, :meth:`tick` and :meth:`status`
    are the required three, and :class:`~jarvis_bots.base.BaseBot` supplies
    usable defaults for the rest.  ``on_pause`` / ``on_resume`` are left at
    their defaults on purpose -- this bot holds no connection to drop.
    """

    #: Declared once, as static identity should be.  ``BaseBot`` refuses to
    #: construct a bot whose ``info`` is not a ``BotInfo``, so a typo here
    #: fails at construction and not in the middle of a round.
    info = INFO

    def __init__(
        self,
        watch_dir: str,
        *,
        clock: Callable[[], float],
        threshold: int = DEFAULT_THRESHOLD,
        probe: Callable[[str], int] = count_entries,
    ) -> None:
        # BaseBot takes the clock, checks it is callable, and exposes it as
        # self.clock / self.now(). tick() is handed the round's ``now`` and
        # should prefer that: every bot in a round then agrees on when the
        # round was.
        super().__init__(clock)

        self._watch_dir = str(watch_dir)
        self._threshold = max(1, int(threshold))
        self._probe = probe

        # --- state, all of it persisted; see snapshot/restore ---
        self._ticks = 0
        self._last_count = 0
        self._peak = 0
        self._last_tick_at = 0.0
        #: Whether ATTENTION_KEY is currently raised.  Persisted too, so a
        #: restart does not re-alert on something the owner has already been
        #: told about.
        self._attention_open = False

    # -- the work ------------------------------------------------------------

    def tick(self, now: float) -> Sequence[Event]:
        """One look at the watched directory (contracts.Bot.tick).

        Returns promptly, never sleeps, and lets a failing probe raise.
        """
        count = self._probe(self._watch_dir)  # may raise; that is handled

        self._ticks += 1
        self._last_count = count
        self._peak = max(self._peak, count)
        self._last_tick_at = now

        events: List[Event] = []

        if count >= self._threshold and not self._attention_open:
            # Crossing up: one ACTION event carrying the stable key. The
            # supervisor turns that into the badge item and, if policy says
            # so, a push. The bot does not decide either.
            self._attention_open = True
            events.append(
                self.event(
                    Severity.ACTION,
                    f"{_plural(count, 'item')} in {self._watch_dir}, "
                    f"over your threshold of {self._threshold}",
                    attention_key=ATTENTION_KEY,
                    href=INFO.href,
                    count=count,
                    threshold=self._threshold,
                    watch_dir=self._watch_dir,
                )
            )
        elif count < self._threshold and self._attention_open:
            # Crossing back down: the same key, below ACTION, so
            # ``Event.wants_attention`` is False -- this is a note for the
            # feed, not a new request. ``resolved=True`` says the same thing
            # in the data, so a supervisor that closes keys on the flag and
            # one that closes them on the severity agree.
            self._attention_open = False
            events.append(
                self.event(
                    Severity.NOTICE,
                    f"Back under the threshold: {_plural(count, 'item')} "
                    f"in {self._watch_dir}",
                    attention_key=ATTENTION_KEY,
                    href=INFO.href,
                    count=count,
                    resolved=True,
                )
            )

        # Note what is *not* here: nothing is re-raised while the count stays
        # high, and an uneventful tick returns nothing at all. A quiet bot
        # should be quiet.
        return tuple(events)

    # -- what the launcher renders --------------------------------------------

    def status(self) -> BotStatus:
        """The card (contracts.BotStatus).  Cheap and never raises: the page
        calls it on every load.

        The bot reports only what the bot knows: IDLE until it has looked at
        anything, RUNNING once it has.  PAUSED and QUARANTINED are the
        *supervisor's* facts about this bot, so they are not invented here;
        ``Supervisor.launcher_state`` overrides the state it owns.

        Stats are pre-formatted, because the bot knows how its own numbers
        should read and the page should not be doing arithmetic.  A bot that
        reported money would format integer cents right here --
        ``f"${cents // 100}.{cents % 100:02d}"`` -- and never hand a float to
        a page.
        """
        if not self._ticks:
            return self.idle_status(f"Nothing read yet from {self._watch_dir}.")
        return BotStatus(
            state=BotState.RUNNING,
            stats=(
                self.stat("Watching", _plural(self._last_count, "item")),
                self.stat("Peak", self._peak),
            ),
            detail=self._detail(),
        )

    def _detail(self) -> str:
        # self.now() is the injected clock, for the moments outside a tick.
        age_s = max(0.0, self.now() - self._last_tick_at)
        return (
            f"{_plural(self._last_count, 'item')} in {self._watch_dir}, "
            f"read {_ago(age_s)}."
        )

    # -- persistence -----------------------------------------------------------

    def snapshot(self) -> Dict[str, Any]:
        """JSON-able state to persist (contracts.Bot.snapshot).

        Only what would be wrong to lose.  The watched directory, the
        threshold and the probe are configuration handed in at construction,
        not state, so they are deliberately absent: a snapshot that pinned
        them would quietly resurrect yesterday's configuration.
        """
        return {
            "version": SNAPSHOT_VERSION,
            "ticks": self._ticks,
            "last_count": self._last_count,
            "peak": self._peak,
            "last_tick_at": self._last_tick_at,
            "attention_open": self._attention_open,
        }

    def restore(self, snapshot: Dict[str, Any]) -> None:
        """Take the state back (contracts.Bot.restore).

        Tolerant on purpose: a snapshot comes off disk, may have been written
        by an older build, and must never stop the bot starting.  An
        unreadable field falls back to the fresh value rather than raising,
        because a bot that will not start is worse than a bot that has
        forgotten its peak.
        """
        if not isinstance(snapshot, dict):
            return
        self._ticks = _as_int(snapshot.get("ticks"), self._ticks)
        self._last_count = _as_int(snapshot.get("last_count"), self._last_count)
        self._peak = _as_int(snapshot.get("peak"), self._peak)
        self._last_tick_at = _as_float(snapshot.get("last_tick_at"), self._last_tick_at)
        self._attention_open = bool(snapshot.get("attention_open", self._attention_open))


def _as_int(value: Any, fallback: int) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return fallback


def _as_float(value: Any, fallback: float) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return fallback


def _ago(seconds: float) -> str:
    """Relative time for the card.  Coarse on purpose: the owner wants to
    know whether a reading is fresh, not to the second."""
    s = int(seconds)
    if s < 60:
        return "just now"
    if s < 3600:
        return _plural(s // 60, "min") + " ago"
    if s < 86400:
        return _plural(s // 3600, "hour") + " ago"
    return _plural(s // 86400, "day") + " ago"


def build(
    *,
    clock: Callable[[], float],
    watch_dir: str = ".",
    threshold: int = DEFAULT_THRESHOLD,
    probe: Callable[[str], int] = count_entries,
) -> "@@BOT_CLASS@@":
    """Construct the bot with everything injected.

    A config can register ``{BOT_ID: lambda: build(clock=clock)}`` without
    knowing the class (``BotRegistry.register_from`` takes a zero-argument
    factory), and this is the one place to change when the bot grows a
    dependency.  ``clock`` is required and has no default: a bot that *can*
    fall back to the wall clock eventually will.
    """
    return @@BOT_CLASS@@(watch_dir, clock=clock, threshold=threshold, probe=probe)
