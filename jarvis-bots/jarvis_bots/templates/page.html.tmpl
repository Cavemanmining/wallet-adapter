<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>@@BOT_NAME_HTML@@</title>
<!--
  The detail page for one bot, generated by jarvis_bots.scaffold.

  Same idiom as web/bots.html, narrowed to a single bot: one endpoint, no
  build step, no framework, and no external requests of any kind -- every
  style, script and glyph below is inline, so the file works from a file://
  path, offline, and inside an app shell that blocks third parties.
-->
<style>
/* Theme tokens ------------------------------------------------------------
   The bare :root is the complete palette: every token the page uses is
   defined here, so nothing falls back to an inherited or missing value.  The
   two blocks after it only *re-point* those tokens.

   - the media block is guarded with :not([data-theme="light"]) so that a
     reader who has explicitly chosen light keeps light on a dark system;
   - the attribute block lets the app force dark without a media query.
   Anything the page needs is a token; no colour is written inline below. */
:root{
  --bg:#f6f4ef; --bg2:#eeebe3; --card:#fffdf8; --rule:#ddd8cc;
  --fg:#1b1810; --fg2:#57513f; --fg3:#847d68;
  --accent:#9a6508; --accent-fg:#fffdf8;
  --ok:#3f7f2c; --warn:#9a6508; --err:#b23a25; --idle:#5a6674;
  --shadow:0 1px 2px rgba(27,24,16,.06);
  --sans:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#14151a; --bg2:#1b1d23; --card:#1a1c22; --rule:#2a2d35;
    --fg:#eceadf; --fg2:#a8a396; --fg3:#7b7668;
    --accent:#e0a72a; --accent-fg:#14151a;
    --ok:#6fbf5a; --warn:#e0a72a; --err:#df5d44; --idle:#6f7b8a;
    --shadow:0 1px 2px rgba(0,0,0,.35);
  }
}
:root[data-theme="dark"]{
  --bg:#14151a; --bg2:#1b1d23; --card:#1a1c22; --rule:#2a2d35;
  --fg:#eceadf; --fg2:#a8a396; --fg3:#7b7668;
  --accent:#e0a72a; --accent-fg:#14151a;
  --ok:#6fbf5a; --warn:#e0a72a; --err:#df5d44; --idle:#6f7b8a;
  --shadow:0 1px 2px rgba(0,0,0,.35);
}

*{box-sizing:border-box}
html,body{margin:0}
body{
  background:var(--bg); color:var(--fg); font-family:var(--sans);
  font-size:16px; line-height:1.45; -webkit-text-size-adjust:100%;
  padding:0 max(16px, env(safe-area-inset-left)) calc(32px + env(safe-area-inset-bottom));
}
.wrap{max-width:760px;margin:0 auto}

header{padding:22px 0 14px;display:flex;align-items:flex-start;gap:12px;flex-wrap:wrap}
.head-main{min-width:0;flex:1}
.crumb{
  display:inline-flex;align-items:center;min-height:44px;gap:6px;
  color:var(--fg2);font-size:13.5px;text-decoration:none;
}
.crumb:hover{color:var(--fg)}
.crumb:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:8px}
h1{font-size:26px;line-height:1.1;letter-spacing:-.02em;margin:0;font-weight:700}
.sub{color:var(--fg2);font-size:13.5px;margin:4px 0 0}
.head-side{display:flex;align-items:center;gap:8px;margin-left:auto}
.demo{
  font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  color:var(--accent-fg);background:var(--accent);padding:4px 9px;border-radius:999px;
}
.demo[hidden]{display:none}

/* Every control is at least 44px tall: this page is read on a phone. */
.btn{
  min-height:44px;min-width:44px;display:inline-flex;align-items:center;
  justify-content:center;gap:7px;padding:0 16px;border-radius:10px;
  border:1px solid var(--rule);background:var(--bg2);color:var(--fg);
  font:inherit;font-size:14.5px;font-weight:650;cursor:pointer;
  text-decoration:none;-webkit-tap-highlight-color:transparent;
}
.btn:hover{border-color:var(--fg3)}
.btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.btn.primary{background:var(--accent);color:var(--accent-fg);border-color:transparent}
.btn[disabled]{opacity:.55;cursor:default}
.btn.icon{padding:0 12px}
.btn svg{width:18px;height:18px}

.card{
  background:var(--card);border:1px solid var(--rule);border-radius:14px;
  padding:14px 15px;display:grid;gap:12px;box-shadow:var(--shadow);
}
.card + .card{margin-top:12px}
.card-top{display:flex;align-items:flex-start;gap:12px}
.icon-badge{
  width:38px;height:38px;flex:none;border-radius:10px;background:var(--bg2);
  display:grid;place-items:center;color:var(--fg2);
}
.icon-badge svg{width:21px;height:21px}
.pill{
  flex:none;display:inline-flex;align-items:center;gap:6px;
  font-size:12px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;
  padding:4px 10px;border-radius:999px;border:1px solid currentColor;white-space:nowrap;
}
.dot{width:7px;height:7px;border-radius:50%;background:currentColor;flex:none}
.pill[data-state="running"]{color:var(--ok)}
.pill[data-state="paused"]{color:var(--warn)}
.pill[data-state="error"]{color:var(--err)}
.pill[data-state="idle"]{color:var(--idle)}

h2{font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
   color:var(--fg3);margin:0}

.stats{display:flex;flex-wrap:wrap;gap:10px 24px;margin:0;padding:0}
.stat{display:grid;gap:1px}
.stat dt{color:var(--fg3);font-size:11px;font-weight:600;letter-spacing:.05em;
         text-transform:uppercase;margin:0}
/* Figures line up column-wise as they change: tabular numerals, always. */
.stat dd{margin:0;font-size:20px;font-weight:650;font-variant-numeric:tabular-nums}

.items{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.item{
  display:flex;gap:10px;align-items:flex-start;
  border-left:3px solid var(--accent);background:var(--bg2);
  padding:10px 12px;border-radius:0 10px 10px 0;
}
.item .txt{flex:1;min-width:0;font-size:14.5px}
.item .since{display:block;color:var(--fg3);font-size:12.5px;
             font-variant-numeric:tabular-nums;margin-top:2px}

.feed{list-style:none;margin:0;padding:0;display:grid;gap:9px}
.ev{display:grid;grid-template-columns:auto 1fr;gap:4px 9px;align-items:baseline;
    font-size:14px;padding-bottom:9px;border-bottom:1px solid var(--rule)}
.feed li:last-child .ev{border-bottom:0;padding-bottom:0}
.sev{
  font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  border:1px solid currentColor;border-radius:999px;padding:1px 7px;white-space:nowrap;
}
.sev[data-sev="action"]{color:var(--accent)}
.sev[data-sev="error"]{color:var(--err)}
.sev[data-sev="notice"]{color:var(--fg2)}
.sev[data-sev="info"],.sev[data-sev="debug"]{color:var(--fg3)}
.ev time{grid-column:2;color:var(--fg3);font-size:12.5px;font-variant-numeric:tabular-nums}
.ev .body{min-width:0;overflow-wrap:anywhere}

.actions{display:flex;gap:9px;flex-wrap:wrap}
.note{
  margin:20px 0 0;padding:12px 14px;border-left:3px solid var(--accent);
  background:var(--bg2);color:var(--fg2);font-size:13.5px;border-radius:0 8px 8px 0;
}
.note b{color:var(--fg)}
.meta{color:var(--fg3);font-size:12.5px;margin:14px 0 0;font-family:var(--mono)}
.state{padding:36px 8px;text-align:center;color:var(--fg2)}
.state h2{font-size:17px;margin:0 0 6px;color:var(--fg);letter-spacing:normal;
          text-transform:none}
.state p{margin:0;font-size:14px}
.empty{color:var(--fg3);font-size:14px;margin:0}
[hidden]{display:none !important}
@media (max-width:420px){
  .card-top{flex-wrap:wrap}
  .pill{order:3;margin-left:50px}
}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="head-main">
      <a class="crumb" href="./bots.html" id="back">&#8592; All bots</a>
      <h1>@@BOT_NAME_HTML@@</h1>
      <p class="sub">@@BOT_BLURB_HTML@@</p>
    </div>
    <div class="head-side">
      <span class="demo" id="demo" hidden>Demo data</span>
      <button type="button" class="btn icon" id="theme" aria-label="Switch theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round" aria-hidden="true"><path d="M20 14.2A8.2 8.2 0 0 1 9.8 4 8.2 8.2 0 1 0 20 14.2Z"/></svg>
      </button>
    </div>
  </header>

  <div class="state" id="loading"><p>Loading&#8230;</p></div>
  <div class="state" id="error" hidden>
    <h2>Could not reach Jarvis</h2>
    <p id="error-detail">The bots service did not answer.</p>
  </div>

  <main id="main" hidden>
    <section class="card" aria-labelledby="h-now">
      <div class="card-top">
        <div class="icon-badge" id="icon" aria-hidden="true"></div>
        <div style="flex:1;min-width:0">
          <h2 id="h-now">Right now</h2>
          <p class="sub" id="detail"></p>
        </div>
        <span class="pill" id="pill" data-state="idle"><span class="dot"></span><span id="pill-word">Idle</span></span>
      </div>
      <dl class="stats" id="stats"></dl>
      <div class="actions">
        <button type="button" class="btn" id="pause" hidden></button>
        <button type="button" class="btn" id="refresh">Refresh</button>
      </div>
    </section>

    <section class="card" aria-labelledby="h-att" id="att-card">
      <h2 id="h-att">Waiting on you</h2>
      <p class="empty" id="att-empty">Nothing needs a decision.</p>
      <ul class="items" id="attention"></ul>
    </section>

    <section class="card" aria-labelledby="h-feed">
      <h2 id="h-feed">Recent events</h2>
      <p class="empty" id="feed-empty">No events yet.</p>
      <ul class="feed" id="feed"></ul>
    </section>

    <p class="meta" id="meta"></p>
  </main>

  <p class="note">
    <b>This bot watches and decides. It never buys.</b>
    When something clears your rules you get an alert with a link to the
    seller&#8217;s own page, and you complete the purchase there. There is no
    checkout anywhere in this UI, and that is on purpose.
  </p>
</div>

<script>
"use strict";

/* Display only. No bot behaviour lives in this file.
 *
 * Live data. Three ways to say where the API is, in this order:
 *
 *   1. window.JARVIS_BOT_API  = "/api/bots/@@BOT_ID@@"
 *   2. <meta name="jarvis-bot-api" content="/api/bots/@@BOT_ID@@">
 *   3. nothing -- the default below, so a page served by the app that owns
 *      /api/bots/ works with no wiring at all.
 *
 * jarvis_bots.api.bot_detail(supervisor, "@@BOT_ID@@") produces exactly the
 * object below, and `python3 -m jarvis_bots.cli detail --id @@BOT_ID@@`
 * prints it, so this page can be driven with no server.
 *
 *   window.JARVIS_BOTS_API  the collection, used only for the pause POST
 *                           described in web/README.md
 *
 *   GET JARVIS_BOT_API ->
 *   { "generated_at": <unix seconds>,
 *     "bot": { "id","name","blurb","kind",
 *              "state": "running" | "paused" | "error" | "idle",
 *              "attention": <int>, "can_pause": <bool>, "href": <string>,
 *              "detail": <string>,
 *              "stats": [ { "label","value" } ],
 *              "attention_items": [ { "key","text","href","since" } ],
 *              "events": [ { "at","severity","text","href" } ] } }
 *
 *   POST JARVIS_BOTS_API + "/pause"  { "bot_id": ..., "paused": <bool> }
 *
 * severity is the contract's word ("action", "notice", ...) or its integer
 * rank; both are accepted, because Severity is an IntEnum and a JSON encoder
 * may hand over either.
 *
 * When nobody has said where the API is and the default is not answering,
 * the page renders DEMO_STATE, says "Demo data" in the header, and keeps
 * saying it. When somebody *has* said, a dead endpoint is an error and the
 * page shows the error: invented figures shown as real would be worse than
 * an empty page, and worse still than a red box. */

var DEMO_STATE = {
  generated_at: 1758340000,
  bot: {
    id: @@BOT_ID_JS@@,
    name: @@BOT_NAME_JS@@,
    blurb: @@BOT_BLURB_JS@@,
    kind: @@BOT_KIND_JS@@,
    state: "running",
    attention: 1,
    can_pause: true,
    href: "#",
    detail: "14 items in ./inbox, read just now.",
    stats: [
      { label: "Watching", value: "14 items" },
      { label: "Peak", value: "17" }
    ],
    attention_items: [
      { key: "@@BOT_ID@@:over-threshold", text: "14 items in ./inbox, over your threshold of 12",
        href: "#", since: 1758338920 }
    ],
    events: [
      { at: 1758338920, severity: "action",
        text: "14 items in ./inbox, over your threshold of 12", href: "#" },
      { at: 1758335200, severity: "notice", text: "Back under the threshold: 9 items in ./inbox" },
      { at: 1758331600, severity: "info", text: "Resumed by owner" }
    ]
  }
};

var ICONS = {
  cart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 4h2l2.2 10.2a1.6 1.6 0 0 0 1.6 1.3h7.4a1.6 1.6 0 0 0 1.6-1.2L20 7.5H6.2"/><circle cx="10" cy="19.2" r="1.3" fill="currentColor" stroke="none"/><circle cx="17" cy="19.2" r="1.3" fill="currentColor" stroke="none"/></svg>',
  grid:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="2"/><circle cx="12" cy="4.4" r="1.5"/><circle cx="19.2" cy="8.4" r="1.5"/><circle cx="19.2" cy="15.8" r="1.5"/><circle cx="12" cy="19.8" r="1.5"/><circle cx="4.8" cy="15.8" r="1.5"/><circle cx="4.8" cy="8.4" r="1.5"/><path d="M12 6v4M17.9 9.2 13.8 11M17.9 15 13.8 13M12 14v4M6.1 15 10.2 13M6.1 9.2 10.2 11"/></svg>',
  radar: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="8.2"/><circle cx="12" cy="12" r="4.4"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/><path d="M12 12 17.8 6.4"/></svg>',
  bot:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="7.5" width="16" height="12" rx="3.5"/><path d="M12 7.5V4.4" stroke-linecap="round"/><circle cx="9.2" cy="13" r="1.3" fill="currentColor" stroke="none"/><circle cx="14.8" cy="13" r="1.3" fill="currentColor" stroke="none"/></svg>'
};

var STATE_WORD = { running: "Running", paused: "Paused", error: "Failing", idle: "Idle" };
var SEV_WORD = ["debug", "info", "notice", "action", "error"];

function el(id) { return document.getElementById(id); }

function sevName(value) {
  if (typeof value === "number" && SEV_WORD[value]) { return SEV_WORD[value]; }
  var word = String(value || "info").toLowerCase();
  return SEV_WORD.indexOf(word) >= 0 ? word : "info";
}

/* Relative time is measured against generated_at from the payload, not the
   device clock, so a phone set to the wrong day still reads correctly. */
function ago(unixSeconds, now) {
  var s = Math.max(0, Math.floor(now - unixSeconds));
  if (s < 60) { return "just now"; }
  var m = Math.floor(s / 60);
  if (m < 60) { return m + (m === 1 ? " min ago" : " mins ago"); }
  var h = Math.floor(m / 60);
  if (h < 24) { return h + (h === 1 ? " hour ago" : " hours ago"); }
  var d = Math.floor(h / 24);
  return d + (d === 1 ? " day ago" : " days ago");
}

var current = null;
var isDemo = false;

function render(state, demo) {
  current = state;
  isDemo = demo;
  var bot = (state && state.bot) || {};
  var now = Number(state && state.generated_at) || Math.floor(Date.now() / 1000);

  el("loading").hidden = true;
  el("error").hidden = true;
  el("main").hidden = false;
  el("demo").hidden = !demo;

  el("icon").innerHTML = ICONS[bot.kind] || ICONS.bot;
  el("detail").textContent = bot.detail || bot.blurb || "";

  var stateKey = STATE_WORD[bot.state] ? bot.state : "idle";
  var attention = Math.max(0, Number(bot.attention) || 0);
  var pill = el("pill");
  pill.dataset.state = stateKey;
  /* The word is always present, so state survives colour blindness, a
     greyscale screen and a screenshot. */
  el("pill-word").textContent = attention > 0
    ? STATE_WORD[stateKey] + " · " + attention
    : STATE_WORD[stateKey];
  pill.setAttribute("aria-label", attention > 0
    ? STATE_WORD[stateKey] + ", " + attention + " needing attention"
    : STATE_WORD[stateKey]);

  var stats = el("stats");
  stats.textContent = "";
  (Array.isArray(bot.stats) ? bot.stats : []).forEach(function (s) {
    var wrap = document.createElement("div");
    wrap.className = "stat";
    var dt = document.createElement("dt");
    dt.textContent = s.label;
    var dd = document.createElement("dd");
    dd.textContent = s.value;
    wrap.append(dt, dd);
    stats.append(wrap);
  });

  var pause = el("pause");
  if (bot.can_pause) {
    var paused = bot.state === "paused";
    pause.hidden = false;
    pause.disabled = false;
    pause.textContent = paused ? "Resume" : "Pause";
    pause.onclick = function () { setPaused(bot, !paused, pause); };
  } else {
    pause.hidden = true;
  }

  var items = Array.isArray(bot.attention_items) ? bot.attention_items : [];
  var list = el("attention");
  list.textContent = "";
  el("att-empty").hidden = items.length > 0;
  items.forEach(function (item) {
    var li = document.createElement("li");
    li.className = "item";
    var txt = document.createElement("div");
    txt.className = "txt";
    txt.textContent = item.text || item.key || "";
    var since = document.createElement("span");
    since.className = "since";
    var at = Number(item.since);
    since.textContent = isFinite(at) && at > 0 ? "since " + ago(at, now) : "";
    txt.append(since);
    li.append(txt);
    /* A decision the owner has to make links out to where they make it.
       The link is all this page does about it: nothing here transacts. */
    if (item.href) {
      var open = document.createElement("a");
      open.className = "btn primary";
      open.href = item.href;
      open.textContent = "Open";
      li.append(open);
    }
    list.append(li);
  });

  var events = Array.isArray(bot.events) ? bot.events.slice(0, 20) : [];
  var feed = el("feed");
  feed.textContent = "";
  el("feed-empty").hidden = events.length > 0;
  events.forEach(function (ev) {
    var li = document.createElement("li");
    var row = document.createElement("div");
    row.className = "ev";
    var sev = document.createElement("span");
    sev.className = "sev";
    var name = sevName(ev.severity);
    sev.dataset.sev = name;
    sev.textContent = name;
    var body = document.createElement("span");
    body.className = "body";
    body.textContent = ev.text || "";
    row.append(sev, body);
    var at = Number(ev.at);
    if (isFinite(at) && at > 0) {
      var t = document.createElement("time");
      t.dateTime = new Date(at * 1000).toISOString();
      t.textContent = ago(at, now);
      row.append(t);
    }
    li.append(row);
    feed.append(li);
  });

  el("meta").textContent = (demo ? "Demo data · " : "")
    + "as of " + new Date(now * 1000).toLocaleString();
}

function fail(detail) {
  el("loading").hidden = true;
  el("main").hidden = true;
  el("error").hidden = false;
  el("error-detail").textContent = detail;
}

var DEFAULT_API = "/api/bots/@@BOT_ID@@";
var DEFAULT_COLLECTION = "/api/bots/";

function apiConfig() {
  if (typeof window.JARVIS_BOT_API === "string" && window.JARVIS_BOT_API) {
    return { url: window.JARVIS_BOT_API, explicit: true };
  }
  var meta = document.querySelector('meta[name="jarvis-bot-api"]');
  var content = meta && meta.getAttribute("content");
  if (content) { return { url: content, explicit: true }; }
  return { url: DEFAULT_API, explicit: false };
}

function load() {
  var cfg = apiConfig();
  fetch(cfg.url, { headers: { accept: "application/json" }, credentials: "same-origin" })
    .then(function (r) {
      if (!r.ok) { throw new Error("HTTP " + r.status); }
      return r.json();
    })
    .then(function (payload) {
      if (!payload || !payload.bot) { throw new Error("not a bot payload"); }
      demoMode = false;
      render(payload, false);
    })
    .catch(function (e) {
      /* Configured explicitly: a dead endpoint is a fault to show. Falling
         back to the default: nobody wired anything, which is the
         standalone-preview case. */
      if (cfg.explicit) { fail("The bots service did not answer (" + e.message + ")."); return; }
      demoMode = true;
      render(DEMO_STATE, true);
    });
}

var demoMode = false;

function setPaused(bot, paused, button) {
  var api = (typeof window.JARVIS_BOTS_API === "string" && window.JARVIS_BOTS_API)
    ? window.JARVIS_BOTS_API
    : DEFAULT_COLLECTION;
  button.disabled = true;
  if (demoMode) {
    /* Demo mode: reflect the choice locally so the control is honestly
       interactive, without pretending anything was saved. */
    bot.state = paused ? "paused" : "running";
    render(current, isDemo);
    return;
  }
  fetch(api.replace(/\/$/, "") + "/pause", {
    method: "POST",
    headers: { "content-type": "application/json" },
    credentials: "same-origin",
    body: JSON.stringify({ bot_id: bot.id, paused: paused })
  }).then(function (r) {
    if (!r.ok) { throw new Error("HTTP " + r.status); }
    load();
  }).catch(function (e) {
    button.disabled = false;
    fail("Could not change that bot: " + e.message);
  });
}

el("refresh").addEventListener("click", load);

/* Theme: the attribute is the only switch. With no attribute set the system
   preference decides, which is why the dark rules are guarded rather than
   applied unconditionally. */
function currentTheme() {
  var attr = document.documentElement.getAttribute("data-theme");
  if (attr === "light" || attr === "dark") { return attr; }
  return (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches)
    ? "dark" : "light";
}

function applyTheme(theme) {
  document.documentElement.setAttribute("data-theme", theme);
  el("theme").setAttribute("aria-label",
    theme === "dark" ? "Switch to the light theme" : "Switch to the dark theme");
}

el("theme").addEventListener("click", function () {
  var next = currentTheme() === "dark" ? "light" : "dark";
  applyTheme(next);
  /* A remembered theme is a convenience, not state the page needs: every
     read and write is guarded, because storage throws in private mode. */
  try { localStorage.setItem("jarvis-theme", next); } catch (e) { /* ignored */ }
});

try {
  var saved = localStorage.getItem("jarvis-theme");
  if (saved === "light" || saved === "dark") { applyTheme(saved); }
} catch (e) { /* storage blocked; the media query still decides */ }

load();
</script>
</body>
</html>
